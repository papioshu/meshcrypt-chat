    <string name="app_name">MeshChat - Privacy Mesh Chat</string>
    <string name="app_description">Privacy-focused mesh networking chat app with end-to-end encryption</string>
    
    <!-- F-Droid App Summary -->
    <string name="fdroid_summary">Privacy-focused mesh networking chat app</string>
    <string name="fdroid_description">A privacy-focused mesh networking chat application that enables secure communication without relying on central servers. Features end-to-end encryption, BLE and LoRa support for peer-to-peer communication, and runs entirely offline for maximum privacy and security.</string>
    
    <!-- Permissions -->
    <string name="permission_bluetooth_title">Bluetooth Connectivity</string>
    <string name="permission_bluetooth_description">Required for peer-to-peer mesh networking via Bluetooth Low Energy. No personal data is collected or transmitted.</string>
    <string name="permission_location_title">Location Access</string>
    <string name="permission_location_description">Required for Bluetooth device discovery and mesh networking proximity features. Location data is never stored or transmitted.</string>
    <string name="permission_storage_title">Storage Access</string>
    <string name="permission_storage_description">Required for encrypted message storage and file attachments. All data is encrypted before storage.</string>
    
